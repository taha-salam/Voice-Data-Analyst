# Voice Data Analyst - Environment Variables Configuration

# Primary LLM API (Groq is used for ultra-low latency sub-second inference)
GROQ_API_KEY=your_groq_api_key_here

# Selected LLM Provider: "groq"
LLM_PROVIDER=groq

# Groq Model Name (openai/gpt-oss-120b or llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# Local STT (faster-whisper model size: tiny.en, base.en, small.en, medium.en)
WHISPER_MODEL_SIZE=base.en

# Local TTS Engine: "pyttsx3" (100% offline local, uses Windows SAPI5 / Linux espeak)
TTS_ENGINE=pyttsx3
