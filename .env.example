# Voice Data Analyst - Environment Variables Configuration

# Primary LLM API (Groq is recommended for ultra-low latency SQL generation)
GROQ_API_KEY=

# Alternative LLM API (Google Gemini)
GEMINI_API_KEY=

# Selected LLM Provider: "groq" or "gemini"
LLM_PROVIDER=groq

# Groq Model Name (e.g. llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini Model Name (e.g. gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Local STT (faster-whisper model size: tiny.en, base.en, small.en, medium.en)
WHISPER_MODEL_SIZE=base.en

# Local TTS Engine: "kokoro", "piper", or "pyttsx3"
TTS_ENGINE=pyttsx3
